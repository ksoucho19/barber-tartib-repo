# -------------------------------------------------------------------
# Supabase Environment Variables — Customer JWT Edge Function
# -------------------------------------------------------------------
# 1. Generate a strong random secret:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 2. Set it in the Supabase project dashboard:
#    Project Settings → API → JWT Secret (copy the existing one and paste below)
#    OR generate a new one BUT make sure it matches the one Supabase uses.
#
#    IMPORTANT: The JWT secret MUST be the SAME secret that Supabase uses
#    to sign its own Auth JWTs, so the API gateway accepts our custom tokens.
#    Go to: Supabase Dashboard → Project Settings → API → JWT Secret
#    Copy that value here.

SUPABASE_JWT_SECRET=<paste-your-supabase-jwt-secret-here>
